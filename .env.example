# Sayr v3 - Environment Variables

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: SUPABASE_SERVICE_ROLE_KEY is NOT used in the mobile app.
# It is only used in Edge Functions (server-side) via Deno.env.get().

# Database
DATABASE_URL=postgresql://postgres:your-password@your-project-id.supabase.co:5432/postgres

# Sentry (Crash Reporting)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_SERVICE_ACCOUNT=your-firebase-service-account-json

# Maps (OpenFreeMap - free, no key needed)
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# OSRM (self-hosted on Hugging Face, private Space)
# Set in Supabase Edge Function secrets (OSRM_URL + HF_TOKEN)
# OSRM_BASE_URL is NOT used client-side; the Flutter app calls get-route-geometry Edge Function

# Zain Cash (Payment Gateway)
ZAINCASH_MERCHANT_ID=your-merchant-id
ZAINCASH_SECRET=your-secret
ZAINCASH_API_URL=https://api.zaincash.iq

# App
APP_VERSION=3.0.0
APP_NAME=Sayr
APP_PACKAGE_ID=com.sayr.sayr_mobile
