# Sayr v3 - Environment Variables

# Supabase
SUPABASE_URL=https://cdydfiiufaebljfduybx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database
DATABASE_URL=postgresql://postgres:your-password@db.cdydfiiufaebljfduybx.supabase.co:5432/postgres

# Sentry (Crash Reporting)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_API_KEY=your-firebase-api-key

# Maps (OpenFreeMap - free, no key needed)
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# OSRM (free public server)
OSRM_BASE_URL=https://router.project-osrm.org

# Stream Chat (v1.1)
STREAM_API_KEY=your-stream-key
STREAM_API_SECRET=your-stream-secret

# Zain Cash (Payment Gateway)
ZAINCASH_MERCHANT_ID=your-merchant-id
ZAINCASH_SECRET=your-secret
ZAINCASH_API_URL=https://api.zaincash.iq

# App
APP_VERSION=3.0.0
APP_NAME=Sayr
APP_PACKAGE_ID=com.sayr.app
